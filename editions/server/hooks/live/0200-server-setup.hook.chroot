#!/usr/bin/env bash
# THMD-Guru Linux Server — Enterprise Provisioning & Hardening Hook
# Owner: server-infra-lead
set -euo pipefail

echo "[THMD-Guru Server Hook] Configuring headless server stack, rate-limited firewall, Cockpit, and Podman..."

echo "server" > /etc/thmd-guru/edition
cp -f /usr/share/thmd-guru/sysctl/91-server.conf /etc/sysctl.d/91-thmd-guru-server.conf 2>/dev/null || true

# Configure nftables baseline firewall with anti-bruteforce rate-limiting on SSH (22) and Cockpit (9090)
cat << 'EOF' > /etc/nftables.conf
#!/usr/sbin/nft -f
flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        ip protocol icmp limit rate 10/second accept
        ip6 nexthdr icmpv6 limit rate 10/second accept
        tcp dport { 22, 9090 } ct state new limit rate 10/minute burst 5 packets accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
EOF

# Enable enterprise server services
systemctl enable ssh.service 2>/dev/null || true
systemctl enable fail2ban.service 2>/dev/null || true
systemctl enable nftables.service 2>/dev/null || true
systemctl enable cockpit.socket 2>/dev/null || true
systemctl enable prometheus-node-exporter.service 2>/dev/null || true
systemctl enable unattended-upgrades.service 2>/dev/null || true

echo "[THMD-Guru Server Hook] Completed."
