#!/usr/bin/env bash
# guru plugin: console — THMD-Guru Linux Server Operations Console
# Owner: server-infra-lead
set -euo pipefail

IP_ADDR="$(hostname -I 2>/dev/null | awk '{print $1}')"
IP_ADDR="${IP_ADDR:-127.0.0.1}"

echo -e "\033[1;33m====================================================================\033[0m"
echo -e "\033[1;36m   THMD-GURU SERVER CONSOLE — ENTERPRISE & CLOUD OPERATIONS        \033[0m"
echo -e "\033[1;33m====================================================================\033[0m"
echo -e "  • Cockpit Web UI  : \033[1;32mhttps://${IP_ADDR}:9090\033[0m"
echo -e "  • Node Exporter   : \033[1;32mhttp://${IP_ADDR}:9100/metrics\033[0m"
echo -e "  • SSH Service     : $(systemctl is-active ssh 2>/dev/null || echo 'inactive') (Key-Only Auth)"
echo -e "  • Firewall (nft)  : $(systemctl is-active nftables 2>/dev/null || echo 'inactive')"
echo -e "  • Fail2ban        : $(systemctl is-active fail2ban 2>/dev/null || echo 'inactive')"
echo -e "  • Container Stack : $(command -v podman >/dev/null && podman --version || echo 'not installed')"
echo -e "\033[1;33m--------------------------------------------------------------------\033[0m"
echo "  Load Avg : $(cut -d' ' -f1-3 /proc/loadavg)"
echo "  Memory   : $(free -h | awk '/^Mem:/ {print $3 " / " $2}')"
echo "  Disk (/) : $(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')"
