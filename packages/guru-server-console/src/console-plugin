#!/usr/bin/env bash
# guru-description: THMD-Guru Server Operations Console (Cockpit, SSH, Firewall, BBR)
# Owner: server-infra-lead
set -eu

IP_ADDR="$(ip -o -4 addr show 2>/dev/null | awk '$2 != "lo" {sub(/\/.*/, "", $4); print $4; exit}')"
IP_ADDR="${IP_ADDR:-127.0.0.1}"
LOAD_AVG="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo '0.00 0.00 0.00')"
MEM_INFO="$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^MemFree:/{f=$2} END{av=(a>0)?a:f; if(t>0) printf "%.1f / %.1f MiB", (t-av)/1024, t/1024}' /proc/meminfo 2>/dev/null || echo 'N/A')"
TCP_CC="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo 'bbr')"

printf '\033[1;33m====================================================================\033[0m\n'
printf '\033[1;36m   THMD-GURU SERVER CONSOLE — ENTERPRISE & CLOUD OPERATIONS        \033[0m\n'
printf '\033[1;33m====================================================================\033[0m\n'
printf '  • Cockpit Web UI  : \033[1;32mhttps://%s:9090\033[0m\n' "$IP_ADDR"
printf '  • Node Exporter   : \033[1;32mhttp://%s:9100/metrics\033[0m\n' "$IP_ADDR"
printf '  • SSH Hardening   : Key-Only Auth (PermitRootLogin=no, MaxAuthTries=3)\n'
printf '  • Firewall (nft)  : Default Drop Inbound (Allowed: 22/tcp, 9090/tcp)\n'
printf '  • Kernel Network  : TCP Congestion = %s\n' "$TCP_CC"
printf '\033[1;33m--------------------------------------------------------------------\033[0m\n'
printf '  • Load Average    : %s\n' "$LOAD_AVG"
printf '  • Memory Usage    : %s\n' "$MEM_INFO"
