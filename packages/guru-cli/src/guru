#!/usr/bin/env bash
# guru — THMD-Guru Linux unified command-line tool.
#
# Built-in subcommands: status, info, harden, lab, update, plugins, version, help.
# Every other subcommand is dispatched to an executable plugin at
#   ${GURU_PLUGIN_DIR:-/usr/lib/guru/commands}/<name>
#
# Compatible with both GNU bash and BusyBox ash (/bin/sh) for Live Initramfs.
# Copyright (c) THMD-Guru Global Tech Academy. License: GPL-3.0-or-later.

set -eu
(set -o pipefail 2>/dev/null) && set -o pipefail

GURU_VERSION="1.0.0"
GURU_CODENAME="Genesis"
GURU_PLUGIN_DIR="${GURU_PLUGIN_DIR:-/usr/lib/guru/commands}"
GURU_UPDATE_HOOK_DIR="${GURU_UPDATE_HOOK_DIR:-/usr/lib/guru/update.d}"
GURU_LABS_DIR="${GURU_LABS_DIR:-/usr/share/thmd-guru/labs}"
GURU_ETC="${GURU_ETC:-/etc/thmd-guru}"
GURU_OS_RELEASE="${GURU_OS_RELEASE:-/etc/os-release}"
PROG="${0##*/}"

init_colors() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
        GURU_COLOR=1
        ESC="$(printf '\033')"
        C_SAPPHIRE="${ESC}[1;34m"
        C_GOLD="${ESC}[1;33m"
        C_LGOLD="${ESC}[0;33m"
        C_TEXT="${ESC}[1;37m"
        C_BOLD="${ESC}[1m"
        C_DIM="${ESC}[2m"
        C_RED="${ESC}[1;31m"
        C_GREEN="${ESC}[1;32m"
        C_RESET="${ESC}[0m"
    else
        GURU_COLOR=0
        C_SAPPHIRE='' C_GOLD='' C_LGOLD='' C_TEXT='' C_BOLD='' C_DIM=''
        C_RED='' C_GREEN='' C_RESET=''
    fi
}

die()  { printf '%s%s: error:%s %s\n' "$C_RED" "$PROG" "$C_RESET" "$*" >&2; exit 1; }
warn() { printf '%s%s: warning:%s %s\n' "$C_GOLD" "$PROG" "$C_RESET" "$*" >&2; }
ok()   { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
fail() { printf '%s[FAIL]%s %s\n' "$C_RED" "$PROG" "$C_RESET" "$*"; }

os_field() {
    key="$1"
    [ -r "$GURU_OS_RELEASE" ] || return 0
    line="$(grep -E "^${key}=" "$GURU_OS_RELEASE" 2>/dev/null | head -n1 || true)"
    line="${line#*=}"
    line="${line%\"}"
    line="${line#\"}"
    printf '%s' "$line"
}

edition() {
    e=""
    if [ -r "$GURU_ETC/edition" ]; then
        e="$(tr -d ' \t\r\n' < "$GURU_ETC/edition")"
    fi
    case "$e" in
        desktop|server|attt) printf '%s' "$e" ;;
        *) printf 'unknown' ;;
    esac
}

edition_label() {
    case "$1" in
        desktop) printf 'Desktop (KDE Plasma)' ;;
        server)  printf 'Server (Enterprise Headless)' ;;
        attt)    printf 'ATTT / Security (XFCE Tactical)' ;;
        *)       printf 'unknown' ;;
    esac
}

uptime_human() {
    s="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)"
    [ -n "$s" ] || s=0
    d=$((s / 86400)); h=$((s % 86400 / 3600)); m=$((s % 3600 / 60))
    if [ "$d" -gt 0 ]; then printf '%dd %dh %dm' "$d" "$h" "$m"
    elif [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"
    else printf '%dm %ds' "$m" "$((s % 60))"; fi
}

mem_human() {
    awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^MemFree:/{f=$2}
         END{
             avail = (a > 0) ? a : f;
             if (t > 0) printf "%.1f / %.1f MiB (%d%%)", (t-avail)/1024, t/1024, (t-avail)*100/t
         }' /proc/meminfo 2>/dev/null || true
}

disk_human() {
    df -h / 2>/dev/null | awk 'NR==2{printf "%s / %s (%s)", $3, $2, $5}' || echo "ramfs (live)"
}

cpu_model() {
    m="$(grep -m1 -E '^model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^ *//' || true)"
    cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"
    printf '%s (%s cores)' "${m:-x86_64 CPU}" "$cores"
}

ip_addrs() {
    if command -v ip >/dev/null 2>&1; then
        ip -o -4 addr show 2>/dev/null | awk '$2 != "lo" {print $2"="$4}' | tr '\n' ' ' || true
    fi
}

valid_name() {
    case "$1" in
        ""|*[!a-z0-9_-]*|-*|_* ) return 1 ;;
        *) return 0 ;;
    esac
}

plugin_path() {
    name="$1"
    valid_name "$name" || return 1
    p="$GURU_PLUGIN_DIR/$name"
    [ -f "$p" ] && [ -x "$p" ] || return 1
    printf '%s' "$p"
}

plugin_desc() {
    d="$(grep -m1 'guru-description:' "$1" 2>/dev/null | sed 's/.*guru-description:[[:space:]]*//' || true)"
    printf '%s' "${d:-(THMD-Guru edition plugin)}"
}

list_plugins() {
    [ -d "$GURU_PLUGIN_DIR" ] || return 0
    for f in "$GURU_PLUGIN_DIR"/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        b="${f##*/}"
        valid_name "$b" || continue
        printf '%s\n' "$b"
    done
}

run_plugin() {
    name="$1"; shift
    p="$(plugin_path "$name")" || {
        printf '%s%s: unknown command:%s %s\n' "$C_RED" "$PROG" "$C_RESET" "$name" >&2
        printf "Run '%s help' to list available commands.\n" "$PROG" >&2
        exit 127
    }
    GURU_EDITION="$(edition)"
    export GURU_VERSION GURU_PLUGIN_DIR GURU_COLOR GURU_EDITION
    exec "$p" "$@"
}

cmd_help() {
    cat <<EOF
${C_GOLD}${C_BOLD}guru${C_RESET} ${GURU_VERSION} (${GURU_CODENAME}) — THMD-Guru Linux Command-Line Interface
${C_SAPPHIRE}THMD-Guru Global Tech Academy — Learn Deep. Build Real. Secure Everything.${C_RESET}

${C_BOLD}Usage:${C_RESET} $PROG <command> [args...]

${C_BOLD}Built-in commands:${C_RESET}
  ${C_LGOLD}info${C_RESET}       Show THMD-Guru Academy logo and OS architecture summary
  ${C_LGOLD}status${C_RESET}     System health summary (CPU, RAM, Kernel, Network, Services)
  ${C_LGOLD}harden${C_RESET}     Audit & apply CIS/KSPP Linux Kernel hardening profile
  ${C_LGOLD}lab${C_RESET}        Manage THMD-Guru Academy hands-on labs (list | info | start)
  ${C_LGOLD}update${C_RESET}     Update system packages via APT (--check | -y)
  ${C_LGOLD}plugins${C_RESET}    List installed edition plugin commands
  ${C_LGOLD}version${C_RESET}    Print guru CLI version
  ${C_LGOLD}help${C_RESET}       Show this help guide
EOF
    names="$(list_plugins)"
    if [ -n "$names" ]; then
        printf '\n%sEdition commands (plugins):%s\n' "$C_BOLD" "$C_RESET"
        for n in $names; do
            printf '  %s%-10s%s %s\n' "$C_LGOLD" "$n" "$C_RESET" "$(plugin_desc "$GURU_PLUGIN_DIR/$n")"
        done
    fi
    printf '\n%sLearn Deep. Build Real. Secure Everything.%s\n' "$C_DIM" "$C_RESET"
}

cmd_version() {
    printf 'guru %s (%s) — THMD-Guru Global Tech Academy\n' "$GURU_VERSION" "$GURU_CODENAME"
}

cmd_plugins() {
    names="$(list_plugins)"
    if [ -z "$names" ]; then
        echo "No plugins installed in $GURU_PLUGIN_DIR"
        return 0
    fi
    for n in $names; do
        printf '%-12s %s\n' "$n" "$(plugin_desc "$GURU_PLUGIN_DIR/$n")"
    done
}

cmd_info() {
    ed="$(edition)"
    name="$(os_field PRETTY_NAME)"
    [ -n "$name" ] || name="THMD-Guru Linux 1.0 (Genesis)"
    ver="$(cat "$GURU_ETC/version" 2>/dev/null || echo "1.0.0")"
    usr="${USER:-$(id -un 2>/dev/null || echo root)}"
    hst="$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo thmd-guru)"
    krn="$(uname -sr 2>/dev/null || echo Linux)"
    upt="$(uptime_human)"
    cpu="$(cpu_model)"
    mem="$(mem_human)"
    dsk="$(disk_human)"

    printf '%s%-26s%s %s@%s\n' "$C_GOLD" " .====================." "$C_RESET" "${C_GOLD}${C_BOLD}${usr}${C_RESET}" "${C_GOLD}${C_BOLD}${hst}${C_RESET}"
    printf '%s%-26s%s %s\n'   "$C_GOLD" " ||  _____   ____    ||" "$C_RESET" "${C_SAPPHIRE}--------------------------------------------${C_RESET}"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" " || |_   _| / ___|   ||" "$C_RESET" "${C_LGOLD}OS      ${C_RESET}" "$name"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" " ||   | |  | |  _    ||" "$C_RESET" "${C_LGOLD}Edition ${C_RESET}" "$(edition_label "$ed")"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" " ||   | |  | |_| |   ||" "$C_RESET" "${C_LGOLD}Version ${C_RESET}" "${ver} (Debian 12 Bookworm)"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" " ||   |_|   \\____|   ||" "$C_RESET" "${C_LGOLD}Kernel  ${C_RESET}" "$krn"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" "  \\\\    G U R U     //" "$C_RESET" "${C_LGOLD}Uptime  ${C_RESET}" "$upt"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" "   \\\\              //"  "$C_RESET" "${C_LGOLD}CPU     ${C_RESET}" "$cpu"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" "    \`\\\\==========//\`"  "$C_RESET" "${C_LGOLD}Memory  ${C_RESET}" "$mem"
    printf '%s%-26s%s %s %s\n' "$C_GOLD" "       \`\\\\____//\`"     "$C_RESET" "${C_LGOLD}Disk /  ${C_RESET}" "$dsk"
    printf '%-26s %s\n' "" "${C_GOLD}THMD-Guru Global Tech Academy${C_RESET}"
    printf '%-26s %s\n' "" "${C_DIM}Learn Deep. Build Real. Secure Everything.${C_RESET}"
}

cmd_status() {
    ed="$(edition)"
    load="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo '0.00 0.00 0.00')"
    if [ "${1:-}" = "--json" ]; then
        printf '{"edition":"%s","version":"%s","kernel":"%s","load":"%s"}\n' \
            "$ed" "$(cat "$GURU_ETC/version" 2>/dev/null || echo 1.0.0)" "$(uname -r)" "$load"
        return 0
    fi
    printf '%s%sTHMD-Guru Linux — System Health Status%s  (%s)\n' "$C_GOLD" "$C_BOLD" "$C_RESET" "$(edition_label "$ed")"
    printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
    printf '  %-14s %s\n' "Host"     "$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo thmd-guru)"
    printf '  %-14s %s\n' "Edition"  "$(edition_label "$ed")"
    printf '  %-14s %s\n' "Kernel"   "$(uname -sr)"
    printf '  %-14s %s\n' "Uptime"   "$(uptime_human)"
    printf '  %-14s %s\n' "Load Avg" "$load"
    printf '  %-14s %s\n' "Memory"   "$(mem_human)"
    printf '  %-14s %s\n' "Disk /"   "$(disk_human)"
    printf '  %-14s %s\n' "IPv4"     "$(ip_addrs)"
    echo
    ok "THMD-Guru Core Identity & Kernel Sysctl Profiles Active"
}

check_sysctl_key() {
    k="$1"; expected="$2"
    p="/proc/sys/$(echo "$k" | tr '.' '/')"
    if [ -r "$p" ]; then
        actual="$(cat "$p" 2>/dev/null || echo '?')"
        if [ "$actual" = "$expected" ]; then
            ok "$k = $actual"
        else
            warn "$k = $actual (recommended: $expected)"
        fi
    fi
}

cmd_harden() {
    ed="$(edition)"
    printf '%s%sTHMD-Guru Linux — CIS / KSPP Kernel Hardening Audit (%s)%s\n' "$C_GOLD" "$C_BOLD" "$ed" "$C_RESET"
    printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
    if [ "${1:-}" = "--apply" ] && [ "$(id -u)" -eq 0 ]; then
        for f in /etc/sysctl.d/90-thmd-guru-base.conf /etc/sysctl.d/91-*.conf; do
            [ -f "$f" ] || continue
            while IFS='=' read -r raw_k raw_v; do
                k="$(echo "$raw_k" | tr -d ' \t')"
                v="$(echo "${raw_v:-}" | sed 's/#.*//' | tr -d ' \t')"
                case "$k" in ""|\#*) continue ;; esac
                p="/proc/sys/$(echo "$k" | tr '.' '/')"
                if [ -w "$p" ]; then
                    echo "$v" > "$p" 2>/dev/null || true
                fi
            done < "$f"
        done
        ok "Applied /etc/sysctl.d/90-thmd-guru-base.conf & edition profile"
    fi
    check_sysctl_key "kernel.kptr_restrict" "2"
    check_sysctl_key "kernel.dmesg_restrict" "1"
    check_sysctl_key "net.ipv4.tcp_syncookies" "1"
    check_sysctl_key "net.ipv4.conf.all.rp_filter" "1"
    check_sysctl_key "fs.protected_hardlinks" "1"
    check_sysctl_key "fs.protected_symlinks" "1"
}

cmd_lab() {
    sub="${1:-list}"
    case "$sub" in
        list)
            printf '%s%sTHMD-Guru Global Tech Academy — Official Lab Catalog%s\n' "$C_GOLD" "$C_BOLD" "$C_RESET"
            printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
            printf '  %s%-18s%s %s\n' "$C_LGOLD" "web-fullstack"  "$C_RESET" "Full-Stack Cloud & Microservices Lab (Nginx + PostgreSQL + Redis)"
            printf '  %s%-18s%s %s\n' "$C_LGOLD" "ai-llm-rag"     "$C_RESET" "Local AI / LLM & Vector Database Lab (Ollama + Qdrant)"
            printf '  %s%-18s%s %s\n' "$C_LGOLD" "cyber-soc-dfir" "$C_RESET" "Cybersecurity Blue Team, SOC & DFIR Forensic Lab"
            ;;
        info|start)
            mod="${2:-web-fullstack}"
            printf '%s[THMD-Guru Lab]%s Module: %s (%s)\n' "$C_GOLD" "$C_RESET" "$mod" "$GURU_LABS_DIR/$mod"
            if [ -f "$GURU_LABS_DIR/$mod/docker-compose.yml" ]; then
                cat "$GURU_LABS_DIR/$mod/docker-compose.yml"
            elif [ -f "$GURU_LABS_DIR/$mod/README.md" ]; then
                cat "$GURU_LABS_DIR/$mod/README.md"
            else
                echo "Lab '$mod' ready. Use Docker/Podman to launch container stack."
            fi
            ;;
        *)
            echo "Usage: guru lab [list|info|start] [module]"
            ;;
    esac
}

cmd_update() {
    if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-c" ]; then
        echo "[THMD-Guru Update] Checking APT repository indexes..."
        command -v apt-get >/dev/null 2>&1 && apt-get -s upgrade || echo "Live RAM environment: no pending package upgrades."
        return 0
    fi
    command -v apt-get >/dev/null 2>&1 || die "apt-get not available in Live RAM mode"
    apt-get update && apt-get full-upgrade -y
}

main() {
    init_colors
    cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        help|-h|--help)       cmd_help "$@" ;;
        version|-V|--version) cmd_version ;;
        status)               cmd_status "$@" ;;
        info)                 cmd_info "$@" ;;
        harden)               cmd_harden "$@" ;;
        lab)                  cmd_lab "$@" ;;
        update)               cmd_update "$@" ;;
        plugins)              cmd_plugins ;;
        *)                    run_plugin "$cmd" "$@" ;;
    esac
}

main "$@"
