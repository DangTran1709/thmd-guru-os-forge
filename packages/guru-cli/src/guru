    printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
    printf '  %-16s %s\n' "Python (uv)"     "~/.local/bin/uv (Fast Python 3.11/3.12/3.13 virtualenv & package manager)"
    printf '  %-16s %s\n' "Node.js (fnm)"   "~/.local/share/fnm (Zero-root Node.js 20/22/24 LTS switcher)"
