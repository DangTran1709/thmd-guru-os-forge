cmd_update() {
    if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-c" ]; then
        echo "[THMD-Guru Update] Checking APT repository indexes..."
        command -v apt-get >/dev/null 2>&1 && apt-get -s upgrade || echo "Live RAM environment: no pending package upgrades."
        return 0
    fi
    command -v apt-get >/dev/null 2>&1 || die "apt-get not available in Live RAM mode"
    apt-get update && apt-get full-upgrade -y
}

main() {
    init_colors
    cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        help|-h|--help)       cmd_help "$@" ;;
        version|-V|--version) cmd_version ;;
        status)               cmd_status "$@" ;;
        info)                 cmd_info "$@" ;;
        harden)               cmd_harden "$@" ;;
        lab)                  cmd_lab "$@" ;;
        vm-node)              cmd_vm_node "$@" ;;
        ai)                   cmd_ai "$@" ;;
        gpu)                  cmd_gpu "$@" ;;
        dev-env)              cmd_dev_env "$@" ;;
        arsenal)              cmd_arsenal "$@" ;;
        update)               cmd_update "$@" ;;
        plugins)              cmd_plugins ;;
        *)                    run_plugin "$cmd" "$@" ;;
    esac
}

main "$@"
