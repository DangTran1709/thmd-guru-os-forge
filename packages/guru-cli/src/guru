cmd_lab() {
    sub="${1:-list}"
    case "$sub" in
        list)
            printf '%s%sTHMD-Guru Global Tech Academy — Official & NCKH Lab Catalog%s\n' "$C_GOLD" "$C_BOLD" "$C_RESET"
            printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "vmware-zap-rag-pfsense" "$C_RESET" "NCKH (VMnet2 192.168.80.0/24 + pfSense): VM1 ZAP (.10), VM2 Target (.20), VM3 AI-RAG (.30)"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "nckh-zap-rag"           "$C_RESET" "NCKH: AI + Hybrid RAG Verifying & Prioritizing OWASP ZAP Alerts (3 Subnets)"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "netops-bgp-sdn"         "$C_RESET" "NetOps: FRRouting BGP/OSPF Spine-Leaf & Throughput Telemetry Lab"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "web-fullstack"          "$C_RESET" "SWE: Full-Stack Cloud & Microservices Lab (Nginx + PostgreSQL + Redis)"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "ai-llm-rag"             "$C_RESET" "AI/MLOps: Local AI / LLM & Vector Database Lab (Ollama + Qdrant)"
            printf '  %s%-24s%s %s\n' "$C_LGOLD" "cyber-soc-dfir"         "$C_RESET" "SecOps: Cybersecurity Blue Team, SOC & DFIR Forensic Lab"
            ;;
        run|benchmark)
            mod="${2:-nckh-zap-rag}"
            shift 2 2>/dev/null || shift $#
            if [ "$mod" = "nckh-zap-rag" ]; then
                run_nckh_zap_rag_benchmark "$@"
            elif [ "$mod" = "vmware-zap-rag-pfsense" ] || [ "$mod" = "lab80-pfsense" ]; then
                run_vmware_zap_rag_pfsense_benchmark "$@"
            else
                cmd_lab info "$mod"
            fi
            ;;
        info|start)
            mod="${2:-nckh-zap-rag}"
            printf '%s[THMD-Guru Lab]%s Module: %s (%s)\n' "$C_GOLD" "$C_RESET" "$mod" "$GURU_LABS_DIR/$mod"
            if [ "$sub" = "start" ] && [ "$mod" = "nckh-zap-rag" ]; then
                run_nckh_zap_rag_benchmark
                return 0
            elif [ "$sub" = "start" ] && [ "$mod" = "vmware-zap-rag-pfsense" ]; then
                run_vmware_zap_rag_pfsense_benchmark
                return 0
            fi
            if [ -f "$GURU_LABS_DIR/$mod/docker-compose.yml" ]; then
                cat "$GURU_LABS_DIR/$mod/docker-compose.yml"
            elif [ -f "$GURU_LABS_DIR/$mod/README.md" ]; then
                cat "$GURU_LABS_DIR/$mod/README.md"
            else
                echo "Lab '$mod' ready. Use 'THMD-guru-ai lab run $mod' or Docker/Podman to launch."
            fi
            ;;
        *)
            echo "Usage: THMD-guru-ai lab [list|info|start|run] [module]"
            ;;
    esac
}

cmd_vm_node() {
    sub="${1:-status}"
    case "$sub" in
