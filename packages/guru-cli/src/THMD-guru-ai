    load="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo '0.00 0.00 0.00')"
    vm_role="$(cat "$GURU_ETC/vm-role" 2>/dev/null || echo 'standalone')"
    if [ "${1:-}" = "--json" ]; then
        printf '{"cli":"THMD-guru-ai","edition":"%s","version":"%s","kernel":"%s","load":"%s","vm_role":"%s"}\n' \
            "$ed" "$(cat "$GURU_ETC/version" 2>/dev/null || echo "$GURU_VERSION")" "$(uname -r)" "$load" "$vm_role"
        return 0
    fi
    printf '%s  SYSTEM TELEMETRY & SECURITY POSTURE - %-40s %s\n' "$BG_SAPPHIRE" "$(edition_label "$ed")" "$C_RESET"
    printf '%s+------------------+------------------------------------------------------------+%s\n' "$C_SAPPHIRE" "$C_RESET"
    printf '%s|%s %-16s %s|%s %-58s %s|%s\n' "$C_SAPPHIRE" "$C_GOLD" "Host / VM Role" "$C_SAPPHIRE" "$C_TEXT" "$(hostname 2>/dev/null || echo thmd-guru)  [Role: $vm_role]" "$C_SAPPHIRE" "$C_RESET"
    printf '%s|%s %-16s %s|%s %-58s %s|%s\n' "$C_SAPPHIRE" "$C_GOLD" "Kernel & Uptime" "$C_SAPPHIRE" "$C_CYAN" "$(uname -sr)  |  Uptime: $(uptime_human)" "$C_SAPPHIRE" "$C_RESET"
    printf '%s|%s %-16s %s|%s %-58s %s|%s\n' "$C_SAPPHIRE" "$C_GOLD" "Memory & Load" "$C_SAPPHIRE" "$C_GREEN" "RAM: $(mem_human)  |  Load: $load" "$C_SAPPHIRE" "$C_RESET"
    printf '%s|%s %-16s %s|%s %-58s %s|%s\n' "$C_SAPPHIRE" "$C_GOLD" "Storage & IPv4" "$C_SAPPHIRE" "$C_TEXT" "Disk: $(disk_human)  |  IP: $(ip_addrs)" "$C_SAPPHIRE" "$C_RESET"
    printf '%s+------------------+------------------------------------------------------------+%s\n' "$C_SAPPHIRE" "$C_RESET"
    ok "THMD-Guru Core Identity, MITRE Auditd & Kernel Sysctl Profiles Active"
}

check_sysctl_key() {
    k="$1"; expected="$2"
    p="/proc/sys/$(echo "$k" | tr '.' '/')"
    if [ -r "$p" ]; then
        actual="$(cat "$p" 2>/dev/null || echo '?')"
        if [ "$actual" = "$expected" ]; then
            ok "$k = $actual"
        else
            warn "$k = $actual (recommended: $expected)"
        fi
    fi
}

cmd_harden() {
    ed="$(edition)"
    printf '%s%sTHMD-Guru Linux - CIS / KSPP Kernel & MITRE ATT&CK Hardening (%s)%s\n' "$C_GOLD" "$C_BOLD" "$ed" "$C_RESET"
    printf '%s%s%s\n' "$C_SAPPHIRE" "------------------------------------------------------------" "$C_RESET"
    if [ "${1:-}" = "--apply" ] && [ "$(id -u)" -eq 0 ]; then
        for f in /etc/sysctl.d/90-thmd-guru-base.conf /etc/sysctl.d/91-*.conf; do
            [ -f "$f" ] || continue
            while IFS='=' read -r raw_k raw_v; do
                k="$(echo "$raw_k" | tr -d ' \t')"
                v="$(echo "${raw_v:-}" | sed 's/#.*//' | tr -d ' \t')"
                case "$k" in ""|\#*) continue ;; esac
                p="/proc/sys/$(echo "$k" | tr '.' '/')"
                if [ -w "$p" ]; then
                    echo "$v" > "$p" 2>/dev/null || true
                fi
            done < "$f"
        done
        if command -v augenrules >/dev/null 2>&1; then
            augenrules --load >/dev/null 2>&1 || true
        fi
        ok "Applied /etc/sysctl.d/90-thmd-guru-base.conf & edition profile"
    fi
    check_sysctl_key "kernel.kptr_restrict" "2"
    check_sysctl_key "kernel.dmesg_restrict" "1"
    check_sysctl_key "net.ipv4.tcp_syncookies" "1"
    check_sysctl_key "net.ipv4.conf.all.rp_filter" "1"
    check_sysctl_key "fs.protected_hardlinks" "1"
    check_sysctl_key "fs.protected_symlinks" "1"
    if [ -f "/etc/audit/rules.d/90-thmd-guru-mitre.rules" ]; then
        ok "MITRE ATT&CK Auditd Ruleset (/etc/audit/rules.d/90-thmd-guru-mitre.rules) installed"
    fi
}

