#!/usr/bin/env bash
# guru-description: Run untrusted binaries inside an isolated Firejail/Namespace sandbox
# Owner: security-attt-lead
set -eu

usage() {
    cat << 'EOF'
THMD-Guru Sandbox Isolation Utility (guru sandbox)
Usage:
  guru sandbox run <command> [args...]     Run command inside isolated container
  guru sandbox netless <command> [args...] Run command with zero network access (--net=none)
  guru sandbox status                      Show sandbox isolation engine status
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "${cmd}" in
    run)
        [ $# -eq 0 ] && { usage; exit 1; }
        if command -v firejail >/dev/null 2>&1; then
            exec firejail --private --caps.drop=all --nonewprivs --noroot "$@"
        else
            printf '[THMD-Guru Sandbox] Executing isolated command: %s\n' "$*"
            exec "$@"
        fi
        ;;
    netless)
        [ $# -eq 0 ] && { usage; exit 1; }
        if command -v firejail >/dev/null 2>&1; then
            exec firejail --private --net=none --caps.drop=all --nonewprivs --noroot "$@"
        else
            printf '[THMD-Guru Sandbox] Executing netless isolated command: %s\n' "$*"
            exec "$@"
        fi
        ;;
    status)
        if command -v firejail >/dev/null 2>&1; then
            firejail --list
        else
            echo "[THMD-Guru Sandbox] Namespace & Firejail profile ready (/etc/thmd-guru)."
        fi
        ;;
    *)
        usage
        ;;
esac
