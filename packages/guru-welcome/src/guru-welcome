"""
THMD-Guru Welcome Center — Global Tech Academy Onboarding & Lab Installer
Supports both GTK3 GUI (when DISPLAY/WAYLAND_DISPLAY is active) and Terminal CLI mode.
Owner: desktop-ux-lead
"""
import os
import subprocess
import sys

TRACKS = [
    ("1. Full-Stack & Cloud Engineering", "Cài đặt VS Code, Podman/Docker, uv/fnm/rustup (THMD-guru-ai dev-env)"),
    ("2. AI & LLM Engineering Lab", "Cài đặt Ollama Local LLM, Qdrant Vector DB & Kernel mmap tuning (THMD-guru-ai gpu)"),
    ("3. Cybersecurity & ATTT Range", "Khởi tạo kho vũ khí OWASP/DFIR, MITRE Auditd & Sandbox (THMD-guru-ai arsenal)"),
    ("4. Phòng Lab NCKH (ZAP + AI + RAG)", "Thực nghiệm AI + Hybrid RAG xác minh cảnh báo OWASP ZAP & VMware Multi-VM (THMD-guru-ai lab run nckh-zap-rag)"),
]

def run_cli():
    print("\033[1;33m====================================================================\033[0m")
    print("\033[1;36m   THMD-GURU WELCOME CENTER — GLOBAL TECH ACADEMY (v1.0 Genesis)   \033[0m")
    print("\033[1;33m   Slogan: Learn Deep. Build Real. Secure Everything.              \033[0m")
    print("\033[1;33m====================================================================\033[0m")
    print("\nLộ trình học tập & Công cụ cài đặt nhanh (1-Click Academy Provisioning):")
    for title, desc in TRACKS:
        print(f"  \033[1;33m{title}\033[0m\n    -> {desc}")
    print("\nLệnh cài đặt & Thực nghiệm NCKH nhanh:")
    print("  THMD-guru-ai welcome --install-vscode   : Cài đặt Visual Studio Code chính thức")
    print("  THMD-guru-ai welcome --install-ollama   : Cài đặt Ollama Local AI Runtime")
    print("  THMD-guru-ai lab run nckh-zap-rag       : Chạy thực nghiệm NCKH AI+RAG với OWASP ZAP")
    print("  THMD-guru-ai vm-node status             : Quản lý sơ đồ 4 máy ảo trên VMware")
    print("  THMD-guru-ai status                     : Kiểm tra trạng thái hệ thống THMD-Guru")

def install_vscode():
    cmd = (
        "curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-archive-keyring.gpg && "
        "echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-archive-keyring.gpg] https://packages.microsoft.com/repos/code stable main' > /etc/apt/sources.list.d/vscode.list && "
        "apt-get update && apt-get install -y code"
    )
    subprocess.run(["pkexec", "bash", "-c", cmd], check=False)

def install_ollama():
    subprocess.run(["bash", "-c", "curl -fsSL https://ollama.com/install.sh | sh"], check=False)

def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk

    css = b"""
    window { background-color: #0A0F1E; color: #E6ECF7; }
    headerbar { background-color: #0C1830; color: #F5D77A; border-bottom: 2px solid #D4AF37; }
    frame { background-color: #112244; border: 1px solid #234178; border-radius: 8px; padding: 6px; }
    frame > label { color: #F5D77A; font-weight: bold; }
    button { background-color: #0B3D91; color: #F5D77A; border: 1px solid #D4AF37; border-radius: 6px; font-weight: bold; padding: 6px 12px; }
    button:hover { background-color: #162B54; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(title="THMD-guru-ai Welcome & NCKH Studio 2.0")
    win.set_default_size(760, 520)
    win.set_border_width(18)
    win.connect("destroy", Gtk.main_quit)

    hb = Gtk.HeaderBar(title="THMD-guru-ai Welcome & NCKH Studio 2.0")
    hb.set_subtitle("THMD-Guru Global Tech Academy — Cyber Sapphire & Royal Gold")
    hb.set_show_close_button(True)
    win.set_titlebar(hb)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    win.add(vbox)

    header = Gtk.Label()
    header.set_markup(
        "<span size='x-large' weight='bold' foreground='#F5D77A'>THMD-Guru Linux 1.0 (Genesis)</span>\n"
        "<span foreground='#60A5FA'>Learn Deep. Build Real. Secure Everything. (WCAG AAA Dark UI)</span>"
    )
    vbox.pack_start(header, False, False, 6)

    for title, desc in TRACKS:
        frame = Gtk.Frame(label=title)
        lbl = Gtk.Label(label=desc, xalign=0.03)
        lbl.set_margin_top(8)
        lbl.set_margin_bottom(8)
        frame.add(lbl)
        vbox.pack_start(frame, False, False, 4)

    btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    btn_nckh = Gtk.Button(label="Chạy Lab NCKH (ZAP + RAG)")
    btn_nckh.connect("clicked", lambda _: subprocess.run(["THMD-guru-ai", "lab", "run", "nckh-zap-rag"], check=False))
    btn_vscode = Gtk.Button(label="Cài đặt VS Code")
    btn_vscode.connect("clicked", lambda _: install_vscode())
    btn_ollama = Gtk.Button(label="Cài đặt Ollama AI")
    btn_ollama.connect("clicked", lambda _: install_ollama())
    btn_close = Gtk.Button(label="Đóng")
    btn_close.connect("clicked", Gtk.main_quit)

    btn_box.pack_start(btn_nckh, True, True, 0)
    btn_box.pack_start(btn_vscode, True, True, 0)
    btn_box.pack_start(btn_ollama, True, True, 0)
    btn_box.pack_start(btn_close, True, True, 0)
    vbox.pack_end(btn_box, False, False, 6)

    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    if "--install-vscode" in sys.argv:
        install_vscode()
    elif "--install-ollama" in sys.argv:
        install_ollama()
    elif "--cli" in sys.argv or (not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY")):
        run_cli()
    else:
        try:
            run_gui()
        except Exception:
            run_cli()
