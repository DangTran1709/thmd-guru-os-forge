#!/usr/bin/env bash
# guru-description: Toggle Stealth Mode (Active MAC Spoofing, IPv4/IPv6 Lockdown & mDNS/LLMNR Block)
# Owner: security-attt-lead
set -eu
(set -o pipefail 2>/dev/null) && set -o pipefail

CONF_NM="/etc/NetworkManager/conf.d/90-thmd-guru-stealth.conf"
STATE_FILE="/run/thmd-guru-stealth.state"
NFT_STEALTH="/etc/thmd-guru/stealth-nftables.nft"

set_sysctl_safe() {
    key="$1"; val="$2"
    proc_path="/proc/sys/$(echo "$key" | tr '.' '/')"
    if [ -w "$proc_path" ]; then
        echo "$val" > "$proc_path" 2>/dev/null || true
    fi
}

randomize_active_macs() {
    if ! command -v ip >/dev/null 2>&1; then
        return 0
    fi
    for iface_path in /sys/class/net/*; do
        [ -e "$iface_path" ] || continue
        iface="${iface_path##*/}"
        case "$iface" in lo|tun*|tap*|wg*|docker*|veth*|br* ) continue ;; esac
        # Generate locally-administered unicast random MAC (x2:xx:xx:xx:xx:xx)
        rand_hex="$(dd if=/dev/urandom bs=1 count=5 2>/dev/null | od -An -tx1 | tr -d ' \n' || echo '4a8f2c91b0')"
        new_mac="02:${rand_hex:0:2}:${rand_hex:2:2}:${rand_hex:4:2}:${rand_hex:6:2}:${rand_hex:8:2}"
        ip link set dev "$iface" down 2>/dev/null || true
        ip link set dev "$iface" address "$new_mac" 2>/dev/null || true
        ip link set dev "$iface" up 2>/dev/null || true
    done
}

enable_stealth() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Vui long chay voi quyen root: sudo guru stealth on" >&2
        exit 1
    fi
    mkdir -p /etc/NetworkManager/conf.d /etc/thmd-guru /run
    cat << 'EOF' > "${CONF_NM}"
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
connection.stable-id=${CONNECTION}/${BOOT}
ipv6.method=ignore
EOF

    # 1. Randomize active NIC MAC addresses immediately
    randomize_active_macs
    systemctl reload NetworkManager 2>/dev/null || true

    # 2. Block IPv4 & IPv6 ICMP Ping + Disable IPv6 to prevent SLAAC EUI-64 MAC leak
    set_sysctl_safe "net.ipv4.icmp_echo_ignore_all" "1"
    set_sysctl_safe "net.ipv4.icmp_echo_ignore_broadcasts" "1"
    set_sysctl_safe "net.ipv6.icmp.echo_ignore_all" "1"
    set_sysctl_safe "net.ipv6.conf.all.disable_ipv6" "1"
    set_sysctl_safe "net.ipv6.conf.default.disable_ipv6" "1"

    # 3. Block mDNS (UDP 5353), LLMNR (TCP/UDP 5355), and NetBIOS (UDP 137-138) leaks via nftables
    cat << 'EOF' > "${NFT_STEALTH}"
table inet thmd_stealth {
    chain input {
        type filter hook input priority -10; policy drop;
        iif "lo" accept
        ct state established,related accept
    }
    chain output {
        type filter hook output priority -10; policy accept;
        udp dport { 137, 138, 5353, 5355 } drop
        tcp dport 5355 drop
    }
}
EOF
    if command -v nft >/dev/null 2>&1; then
        nft -f "${NFT_STEALTH}" 2>/dev/null || true
    fi

    echo "ACTIVE" > "${STATE_FILE}"
    printf '\033[1;32m[THMD-Guru Stealth] ACTIVE: Active MAC Spoofed + IPv4/IPv6 ICMP Ignored + IPv6 Disabled + mDNS/LLMNR Blocked.\033[0m\n'
}

disable_stealth() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Vui long chay voi quyen root: sudo guru stealth off" >&2
        exit 1
    fi
    rm -f "${CONF_NM}" "${STATE_FILE}" "${NFT_STEALTH}"
    if command -v nft >/dev/null 2>&1; then
        nft delete table inet thmd_stealth 2>/dev/null || true
    fi
    set_sysctl_safe "net.ipv4.icmp_echo_ignore_all" "0"
    set_sysctl_safe "net.ipv6.icmp.echo_ignore_all" "0"
    set_sysctl_safe "net.ipv6.conf.all.disable_ipv6" "0"
    set_sysctl_safe "net.ipv6.conf.default.disable_ipv6" "0"
    systemctl reload NetworkManager 2>/dev/null || true
    printf '\033[1;33m[THMD-Guru Stealth] INACTIVE: Standard network profile restored.\033[0m\n'
}

status_stealth() {
    if [ -f "${CONF_NM}" ] || [ -f "${STATE_FILE}" ]; then
        printf 'Stealth Mode Status: \033[1;32mACTIVE (MAC Spoofing + IPv6 Off + ICMP/mDNS/LLMNR Blocked)\033[0m\n'
    else
        printf 'Stealth Mode Status: \033[1;33mINACTIVE (Disabled)\033[0m\n'
    fi
}

case "${1:-status}" in
    on|enable)   enable_stealth ;;
    off|disable) disable_stealth ;;
    status)      status_stealth ;;
    *)           echo "Usage: guru stealth [on|off|status]" >&2; exit 1 ;;
esac
