#!/usr/bin/env bash
# guru plugin: stealth — Network Privacy, MAC Randomization & Lockdown Mode
# Owner: security-attt-lead
set -euo pipefail

CONF_NM="/etc/NetworkManager/conf.d/90-thmd-guru-stealth.conf"

enable_stealth() {
    if [[ "$(id -u)" -ne 0 ]]; then
        echo "Vui lòng chạy với quyền root: sudo guru stealth on"
        exit 1
    fi
    mkdir -p /etc/NetworkManager/conf.d
    cat << 'EOF' > "${CONF_NM}"
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
connection.stable-id=${CONNECTION}/${BOOT}
EOF
    systemctl reload NetworkManager 2>/dev/null || true
    sysctl -w net.ipv4.icmp_echo_ignore_all=1 >/dev/null 2>&1 || true
    echo -e "\033[1;32m[THMD-Guru Stealth] ĐÃ BẬT chế độ Stealth (Random MAC + Chặn ICMP Ping + Khóa Inbound).\033[0m"
}

disable_stealth() {
    if [[ "$(id -u)" -ne 0 ]]; then
        echo "Vui lòng chạy với quyền root: sudo guru stealth off"
        exit 1
    fi
    rm -f "${CONF_NM}"
    systemctl reload NetworkManager 2>/dev/null || true
    sysctl -w net.ipv4.icmp_echo_ignore_all=0 >/dev/null 2>&1 || true
    echo -e "\033[1;33m[THMD-Guru Stealth] ĐÃ TẮT chế độ Stealth.\033[0m"
}

status_stealth() {
    if [[ -f "${CONF_NM}" ]]; then
        echo -e "Trạng thái Stealth Mode: \033[1;32mACTIVE (Đang bật)\033[0m"
    else
        echo -e "Trạng thái Stealth Mode: \033[1;33mINACTIVE (Đang tắt)\033[0m"
    fi
}

case "${1:-status}" in
    on|enable)   enable_stealth ;;
    off|disable) disable_stealth ;;
    status)      status_stealth ;;
    *)
        echo "Sử dụng: sudo guru stealth [on|off|status]"
        ;;
esac
