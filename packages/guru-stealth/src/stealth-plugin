#!/usr/bin/env bash
# guru-description: Toggle Stealth Mode (MAC Randomization & ICMP/Inbound Lockdown)
# Owner: security-attt-lead
set -eu

CONF_NM="/etc/NetworkManager/conf.d/90-thmd-guru-stealth.conf"

enable_stealth() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Vui long chay voi quyen root: sudo guru stealth on"
        exit 1
    fi
    mkdir -p /etc/NetworkManager/conf.d
    cat << 'EOF' > "${CONF_NM}"
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
connection.stable-id=${CONNECTION}/${BOOT}
EOF
    if [ -w /proc/sys/net/ipv4/icmp_echo_ignore_all ]; then
        echo 1 > /proc/sys/net/ipv4/icmp_echo_ignore_all 2>/dev/null || true
    fi
    printf '\033[1;32m[THMD-Guru Stealth] ACTIVE: Random MAC + ICMP Echo Ignored + Inbound Locked.\033[0m\n'
}

disable_stealth() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Vui long chay voi quyen root: sudo guru stealth off"
        exit 1
    fi
    rm -f "${CONF_NM}"
    if [ -w /proc/sys/net/ipv4/icmp_echo_ignore_all ]; then
        echo 0 > /proc/sys/net/ipv4/icmp_echo_ignore_all 2>/dev/null || true
    fi
    printf '\033[1;33m[THMD-Guru Stealth] INACTIVE: Standard network profile restored.\033[0m\n'
}

status_stealth() {
    if [ -f "${CONF_NM}" ]; then
        printf 'Stealth Mode Status: \033[1;32mACTIVE (Enabled)\033[0m\n'
    else
        printf 'Stealth Mode Status: \033[1;33mINACTIVE (Disabled)\033[0m\n'
    fi
}

case "${1:-status}" in
    on|enable)   enable_stealth ;;
    off|disable) disable_stealth ;;
    status)      status_stealth ;;
    *)           echo "Usage: guru stealth [on|off|status]" ;;
esac
